// ==============================================================================
// Prisma Schema for Template Microservice
// AyantrAI Sitesafe ERP
// Database: PostgreSQL
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TemplateStatus {
  draft
  pending
  active
  rejected
}

model ReportTemplate {
  id                  String         @id
  name                String
  description         String?        @db.Text
  siteId              String?        @map("site_id")
  siteName            String?        @map("site_name")
  status              TemplateStatus @default(draft)
  version             String         @default("v1.0")
  category            String?
  frequency           String?
  complianceStandards Json?          @map("compliance_standards")
  hasAuditHash        Boolean        @default(false) @map("has_audit_hash")
  blocks              Json?
  coverPageData       Json?          @map("cover_page_data")
  tableOfContentsData Json?          @map("table_of_contents_data")
  backCoverData       Json?          @map("back_cover_data")
  canvasSectionId     String?        @map("canvas_section_id")
  createdBy           String?        @map("created_by")
  authorName          String?        @map("author_name")
  approvedBy          String?        @map("approved_by")
  approvedAt          DateTime?      @map("approved_at") @db.Timestamptz
  rejectionReason     String?        @map("rejection_reason") @db.Text
  remarks             String?        @db.Text
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("report_templates")
}

model Watermark {
  id          String   @id @default(uuid())
  name        String
  fileName    String   @map("file_name")
  svgContent  String   @map("svg_content") @db.Text
  sizeBytes   Int      @default(0) @map("size_bytes")
  scale       Float    @default(100.0)
  opacity     Float    @default(18.0)
  rotation    Float    @default(0.0)
  placement   String   @default("center")
  tag         String?  @default("custom")
  isDefault   Boolean  @default(false) @map("is_default")
  description String?  @db.Text
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("watermarks")
}

model TemplateSection {
  id                  String   @id
  name                String
  titleHtml           String?  @map("title_html") @db.Text
  titleStyle          Json?    @map("title_style")
  eyebrow             String   @default("CUSTOM MODULE")
  eyebrowHtml         String?  @map("eyebrow_html")
  description         String?  @db.Text
  descriptionHtml     String?  @map("description_html") @db.Text
  type                String   @default("custom") // "core" | "custom"
  icon                String?  @default("Layers")
  isTemplate          Boolean  @default(false) @map("is_template")
  orderIndex          Int      @default(0) @map("order_index")
  headerSpacing       String?  @default("normal") @map("header_spacing")
  sectionStyle        Json?    @map("section_style")
  metricCards         Json?    @default("[]") @map("metric_cards")
  charts              Json?    @default("[]")
  keyInsights         Json?    @default("[]") @map("key_insights")
  canvasRows          Json?    @default("[]") @map("canvas_rows")
  stamps              Json?    @default("[]")
  watermarkId         String?  @map("watermark_id")
  projectSite         String?  @map("project_site")
  reportingPeriod     String?  @map("reporting_period")
  coverPageData       Json?    @map("cover_page_data")
  tableOfContentsData Json?    @map("table_of_contents_data")
  backCoverData       Json?    @map("back_cover_data")
  pageOverrides       Json?    @map("page_overrides")
  createdBy           String?  @map("created_by")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("template_sections")
}

