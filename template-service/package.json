{
  "name": "ayantrai-template-service",
  "version": "1.0.0",
  "description": "Standalone Template & Canvas Blueprint Microservice for Sitesafe ERP by AyantrAI",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts"
  },
  "keywords": [
    "microservice",
    "templates",
    "canvas",
    "blueprints",
    "express",
    "prisma",
    "postgresql",
    "ayantrai"
  ],
  "author": "AyantrAI Dev Team",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.13.4",
    "prisma": "^6.4.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
