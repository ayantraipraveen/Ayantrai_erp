# ==============================================================================
# ERP-Ayantrai Backend Environment Variables
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# Primary Database: PostgreSQL (Managed by Prisma ORM)
# ------------------------------------------------------------------------------
# Connection string syntax:
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ayantrai_erp?schema=public"

# ------------------------------------------------------------------------------
# Secondary Database: MongoDB (Config Ready / Standby Mode)
# ------------------------------------------------------------------------------
# Connection string syntax:
# mongodb://[username:password@]host1[:port1][,...hostN[:portN]][/[defaultauthdb][?options]]
MONGODB_URI="mongodb://localhost:27017/ayantrai_erp"
# Set to 'true' when you want the server to actively connect to MongoDB
MONGODB_ENABLED=false

# ------------------------------------------------------------------------------
# Security & JWT Tokens
# ------------------------------------------------------------------------------
JWT_SECRET="ayantrai-erp-development-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"
